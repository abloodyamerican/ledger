<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Everything is backed up and moved to a new phone except the
     encrypted Claude API key, which only works on this phone anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ledger_ai.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ledger_ai.xml"/>
    </device-transfer>
</data-extraction-rules>
